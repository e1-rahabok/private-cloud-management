# /etc/pcm/pcm.env, owned by root, mode 640, group pcm. Never commit the real file.
PCM_HOST=0.0.0.0
PCM_PORT=8080
PCM_DB=/var/lib/pcm/pcm.sqlite
# Agent E2 through the AI gateway (lab and demo only; a customer site points Agent E2 at its local model server).
# Read by PCM for drafts and by the Agent E2 service (deploy/agent-e2.service) for answers and embeddings.
# Empty: drafts show the built-in fallback text, and the Agent E2 panel says its model cannot be reached.
AI_GATEWAY_API_KEY=
# Where PCM finds the Agent E2 service (deploy/README.md, Agent E2).
PCM_AGENT_E2_URL=http://127.0.0.1:8090
